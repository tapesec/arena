{
  "name": "arena",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @arena/server",
    "dev:client": "npm run dev -w @arena/client",
    "build": "npm run build -w @arena/client",
    "start": "npm run start -w @arena/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server:duo": "MATCH_SIZE=2 npm run dev -w @arena/server",
    "deploy-assets": "tsx scripts/deploy-assets.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
